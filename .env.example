# Public — safe to expose in the browser
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never prefix these with VITE_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Stripe test/live mode is explicit. Live additionally requires STRIPE_LIVE_ENABLED=true.
STRIPE_PAYMENTS_ENABLED=false
STRIPE_MODE=test
STRIPE_LIVE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# InPost ShipX PL. Start on stage; live additionally requires INPOST_LIVE_ENABLED=true.
INPOST_MODE=stage
INPOST_LIVE_ENABLED=false
INPOST_STAGE_TOKEN=...
INPOST_STAGE_ORGANIZATION_ID=...
INPOST_STAGE_WEBHOOK_SECRET=...
INPOST_LIVE_TOKEN=...
INPOST_LIVE_ORGANIZATION_ID=...
INPOST_LIVE_WEBHOOK_SECRET=...
# Set this to body only if InPost configures the HMAC over the raw body without timestamp.
INPOST_WEBHOOK_SIGNATURE_PAYLOAD=timestamp_body
ORLEN_PACZKA_PARTNER_ID=...
ORLEN_PACZKA_PARTNER_KEY=...
DPD_API_KEY=...
DHL_API_KEY=...
APP_URL=https://YOUR_DOMAIN
